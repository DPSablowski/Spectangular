                 <item row="8" column="0" colspan="2">
                  <widget class="QCheckBox" name="checkBox_norm">
                   <property name="text">
                    <string>Also write continuum-normalised A and B (*_norm) and plot them</string>
                   </property>
                   <property name="toolTip">
                    <string>Fits a continuum to each disentangled component: a cubic spline per piece between excluded ranges, through the upper points (points more than the chosen number of sigma below the fit are lines, more than 3 sigma above are spikes; sigma from the points above the fit; iterated). Writes A and B divided by it as &lt;name&gt;_norm.&lt;ext&gt; beside the files as they come from the disentangling, and plots the normalised spectra.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="9" column="0">
                  <widget class="QLabel" name="lbl_normKnot">
                   <property name="text">
                    <string>Continuum: spline knots every</string>
                   </property>
                  </widget>
                 </item>
                 <item row="9" column="1">
                  <widget class="QDoubleSpinBox" name="doubleSpinBox_normKnot">
                   <property name="suffix">
                    <string> Å</string>
                   </property>
                   <property name="decimals">
                    <number>0</number>
                   </property>
                   <property name="minimum">
                    <double>10.0</double>
                   </property>
                   <property name="maximum">
                    <double>5000.0</double>
                   </property>
                   <property name="singleStep">
                    <double>10.0</double>
                   </property>
                   <property name="value">
                    <double>80.0</double>
                   </property>
                   <property name="toolTip">
                    <string>Distance of the spline knots of the continuum fit. Smaller: follows broader wiggles more closely but also broad lines (Balmer wings); larger: smoother. Pieces shorter than this get a straight line (shorter than 20 Å: a constant).</string>
                   </property>
                  </widget>
                 </item>
                 <item row="10" column="0">
                  <widget class="QLabel" name="lbl_normLow">
                   <property name="text">
                    <string>Continuum: reject points below the fit by more than</string>
                   </property>
                  </widget>
                 </item>
                 <item row="10" column="1">
                  <widget class="QDoubleSpinBox" name="doubleSpinBox_normLow">
                   <property name="suffix">
                    <string> σ</string>
                   </property>
                   <property name="decimals">
                    <number>1</number>
                   </property>
                   <property name="minimum">
                    <double>0.5</double>
                   </property>
                   <property name="maximum">
                    <double>5.0</double>
                   </property>
                   <property name="singleStep">
                    <double>0.1</double>
                   </property>
                   <property name="value">
                    <double>1.5</double>
                   </property>
                   <property name="toolTip">
                    <string>Points this far below the continuum fit count as lines and are left out (sigma from the points above the fit). Smaller: the continuum follows the upper envelope more closely (line-rich, cool stars); larger: closer to the mean of the continuum points (white noise, few lines).</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
